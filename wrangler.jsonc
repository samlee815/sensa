// Cloudflare Workers static assets: serves the static export in out/ at wearsensa.com.
{
  "name": "wearsensa",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "wearsensa.com", "custom_domain": true },
    { "pattern": "www.wearsensa.com", "custom_domain": true }
  ]
}
